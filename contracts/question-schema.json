{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprintjudge.local/contracts/question-schema.json",
  "title": "Question",
  "type": "object",
  "required": ["id", "subject", "unit", "topic", "scope", "cognitiveDemand", "format", "stem", "answer", "explanation", "hint", "difficulty", "provenance", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+-[0-9]+\\.[0-9]+-[0-9]{4}$" },
    "subject": { "type": "string", "enum": ["JAVA_PROGRAMMING", "COMPUTING_FOUNDATIONS", "CHEMISTRY", "CALCULUS_I", "CALCULUS_II", "PHYSICS_I", "PHYSICS_II", "PHYSICS_MECHANICS", "PHYSICS_EM", "EUROPEAN_HISTORY", "US_HISTORY", "WORLD_HISTORY", "MACROECONOMICS", "MICROECONOMICS", "STATISTICS", "US_GOVERNMENT", "COMPARATIVE_GOVERNMENT", "PSYCHOLOGY", "ENVIRONMENTAL_SCIENCE", "HUMAN_GEOGRAPHY", "ENGLISH_LANGUAGE", "ENGLISH_LITERATURE", "BIOLOGY", "SPANISH", "FRENCH", "GERMAN", "CHINESE", "ART_HISTORY", "MUSIC_THEORY", "PRECALCULUS", "RESEARCH_METHODS", "SEMINAR", "ALGEBRA_I", "ALGEBRA_II", "GEOMETRY", "INTEGRATED_1", "INTEGRATED_2", "INTEGRATED_3", "PYTHON", "WEB_DEVELOPMENT", "CYBERSECURITY", "DATA_SCIENCE"] },
    "unit": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "learningObjective": { "type": "string" },
    "practice": { "type": "string" },
    "scope": { "type": "string", "enum": ["current-scope", "legacy-scope", "core-scope"] },
    "cognitiveDemand": {
      "type": "object",
      "required": ["bloom", "dok"],
      "properties": {
        "bloom": { "type": "string", "enum": ["REMEMBER", "UNDERSTAND", "APPLY", "ANALYZE", "EVALUATE", "CREATE"] },
        "dok": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "format": { "type": "string", "enum": ["STIMULUS_MCQ", "CONCEPT_MCQ", "MULTI_SELECT", "NUMERIC", "ORDERING", "BUG_SPOTTING", "CODE_COMPLETION", "JUDGED_PROBLEM", "FREE_RESPONSE", "TWO_STAGE", "DATA_INTERPRETATION", "SOURCE_BASED", "DIAGRAM", "CALCULATION_WITH_UNITS", "PROOF", "EXPERIMENT_DESIGN", "ERROR_ANALYSIS", "EXPLANATION", "CODE_TRACING", "FILE_DATASET", "IMAGE_INTERPRETATION", "LISTENING_RESPONSE", "COMPOSITION", "SYNTHESIS", "RHETORICAL_ANALYSIS", "FORMULA_APPLICATION", "CONCEPTUAL_REASONING"] },
    "stimulus": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string" },
        "body": { "type": "string" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "stem": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "object", "required": ["id", "text", "misconception"], "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "misconception": { "type": "string" } } } },
    "answer": { "type": "object" },
    "explanation": { "type": "string", "minLength": 1 },
    "hint": { "type": "string" },
    "difficulty": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "discrimination": { "type": "number" },
    "responseTimeBaseline": { "type": "object", "properties": { "p25Sec": { "type": "number" }, "medianSec": { "type": "number" }, "p75Sec": { "type": "number" } } },
    "provenance": {
      "type": "object",
      "required": ["author", "reviewer", "reviewedAt", "aiAssisted", "stimulusLicense", "attestation"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "aiAssisted": { "type": "boolean" },
        "aiModel": { "type": ["string", "null"] },
        "aiRunId": { "type": ["string", "null"] },
        "humanReviewer": { "type": ["string", "null"] },
        "stimulusLicense": { "type": ["string", "null"] },
        "fairUseRationale": { "type": ["string", "null"] },
        "attestation": { "type": "string", "minLength": 1 }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "relatedQuestionIds": { "type": "array", "items": { "type": "string" } },
    "prerequisiteQuestionIds": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 }
  }
}
