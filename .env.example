# SprintJudge backend environment
# Copy to `.env` (same folder as the jar, or the project root under Maven)
# and uncomment what you need. Real OS environment variables always win.

# --- Storage -----------------------------------------------------------
# SQLite file location. Default: <jar-folder>/database/sprintjudge.db in prod,
# ./database/sprintjudge.db in dev. Parent folders are created automatically.
# Use forward slashes on all platforms (backslashes break .env sourcing).
#SPRINTJUDGE_DB_PATH=D:/data/sprintjudge/sprintjudge.db

# --- HTTP --------------------------------------------------------------
# Listen port for the production jar. Default: 8080.
#SPRINTJUDGE_PORT=8080

# --- Judge isolation: native | nsjail -----------------------------------
# Native needs no WSL and no extra runtime (gcc/g++/javac/node/python on PATH).
# Linux production should pin nsjail for sandboxing.
#SPRINTJUDGE_EXECUTOR_MODE=native

# --- CORS --------------------------------------------------------------
# Comma-separated origins when serving the UI from another host.
#SPRINTJUDGE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Admin credentials (temporary MVP login) ---------------------------
SPRINTJUDGE_ADMIN_USERNAME=admin
# Set a strong password before first boot; prod refuses the default "changeme".
#SPRINTJUDGE_ADMIN_PASSWORD=change-me-before-deploy

# --- OAuth2 sign-in (optional, password login always stays available) ---
# A provider is enabled only when its client id is set. Redirect URI:
#   https://<your-origin>/login/oauth2/code/<provider-id>
#SPRINTJUDGE_GOOGLE_CLIENT_ID=
#SPRINTJUDGE_GOOGLE_CLIENT_SECRET=
#SPRINTJUDGE_GITHUB_CLIENT_ID=
#SPRINTJUDGE_GITHUB_CLIENT_SECRET=
#SPRINTJUDGE_MICROSOFT_CLIENT_ID=
#SPRINTJUDGE_MICROSOFT_CLIENT_SECRET=
#SPRINTJUDGE_MICROSOFT_TENANT=common
# Generic OIDC provider
#SPRINTJUDGE_OIDC_ISSUER=
#SPRINTJUDGE_OIDC_CLIENT_ID=
#SPRINTJUDGE_OIDC_CLIENT_SECRET=
# basis-auth (OIDC in front of Microsoft Entra ID)
#BASIS_AUTH_ISSUER=
#BASIS_AUTH_CLIENT_ID=
#BASIS_AUTH_CLIENT_SECRET=
# Resource audience and its secret (for backchannel webhook proof and the
# /api/public/basis/whoami resource endpoint).
#BASIS_AUTH_RESOURCE=urn:sprintjudge:api
#BASIS_AUTH_RESOURCE_SECRET=
#BASIS_AUTH_INTERNAL_URL=http://127.0.0.1:3001
# OAuth2 users get ADMIN only when their email is in this comma list.
#SPRINTJUDGE_ADMIN_EMAILS=teacher@example.org

# --- AI Grading (optional) ----------------------------------------------
# Enable AI-powered code review and feedback for coding submissions.
# Works with any OpenAI-compatible API (cloud or local llama.cpp).
#SPRINTJUDGE_AI_ENABLED=true
#SPRINTJUDGE_AI_PROVIDER=openai          # "openai" or "llamacpp"
#SPRINTJUDGE_AI_ENDPOINT=http://localhost:11434/v1  # llama.cpp default
#SPRINTJUDGE_AI_MODEL=llama3             # or gpt-3.5-turbo, gpt-4, etc.
#SPRINTJUDGE_AI_API_KEY=                  # leave empty for local llama.cpp
#SPRINTJUDGE_AI_TIMEOUT_SEC=30
