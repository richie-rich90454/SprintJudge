# SprintJudge backend environment
# Copy to `.env` (same folder as the jar, or the project root under Maven)
# and uncomment what you need. Real OS environment variables always win.

# --- Storage -----------------------------------------------------------
# SQLite file location. Default: <jar-folder>/sprintjudge.db in prod,
# ./sprintjudge.db in dev. Parent folders are created automatically.
#SPRINTJUDGE_DB_PATH=D:\data\sprintjudge\sprintjudge.db

# --- HTTP --------------------------------------------------------------
#SPRINTJUDGE_PORT=8080

# --- Judge isolation: native | wsl | nsjail ----------------------------
# Linux production should pin nsjail; Windows uses native.
#SPRINTJUDGE_EXECUTOR_MODE=native

# --- CORS --------------------------------------------------------------
# Comma-separated origins; default is the Vite dev origin.
#SPRINTJUDGE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Microsoft Entra ID admin sign-in ----------------------------------
#SPRINTJUDGE_MS_CLIENT_ID=your-client-id
#SPRINTJUDGE_MS_CLIENT_SECRET=your-client-secret
#SPRINTJUDGE_MS_TENANT_ID=common
