{
  "dashboard": {
    "title": "SprintJudge",
    "uid": "sprintjudge",
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "title": "Active Rooms",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "sprintjudge_rooms_active", "legendFormat": "rooms" }],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 10, "color": "yellow" }, { "value": 50, "color": "red" }] } } }
      },
      {
        "title": "Total Games Created",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [{ "expr": "sprintjudge_games_created_total", "legendFormat": "games" }]
      },
      {
        "title": "Total Players Joined",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [{ "expr": "sprintjudge_players_joined_total", "legendFormat": "players" }]
      },
      {
        "title": "Active Threads",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [{ "expr": "sprintjudge_threads_active", "legendFormat": "threads" }]
      },
      {
        "title": "Judge Runs / Timeouts",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          { "expr": "rate(sprintjudge_judge_runs_total[1m])", "legendFormat": "runs/sec" },
          { "expr": "rate(sprintjudge_judge_timeouts_total[1m])", "legendFormat": "timeouts/sec" }
        ]
      },
      {
        "title": "Submissions (correct vs total)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          { "expr": "rate(sprintjudge_submissions_total[1m])", "legendFormat": "total/sec" },
          { "expr": "rate(sprintjudge_submissions_correct_total[1m])", "legendFormat": "correct/sec" }
        ]
      },
      {
        "title": "Heap Memory (MB)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [{ "expr": "sprintjudge_memory_heap_used_mb", "legendFormat": "heap used" }]
      },
      {
        "title": "Write Buffer Depth",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [{ "expr": "sprintjudge_persistence_buffer_depth", "legendFormat": "depth" }]
      },
      {
        "title": "Judge Permits Available",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
        "targets": [{ "expr": "sprintjudge_judge_permits_available", "legendFormat": "permits" }],
        "fieldConfig": { "defaults": { "min": 0, "max": 32 } }
      },
      {
        "title": "Broadcast Pending Rooms",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
        "targets": [{ "expr": "sprintjudge_broadcast_pending_rooms", "legendFormat": "rooms" }],
        "fieldConfig": { "defaults": { "min": 0 } }
      },
      {
        "title": "Compile Cache",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
        "targets": [{ "expr": "sprintjudge_compile_cache_entries", "legendFormat": "entries" }]
      }
    ],
    "time": { "from": "now-1h", "to": "now" },
    "schemaVersion": 39
  }
}
