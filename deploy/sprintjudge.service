[Unit]
Description=SprintJudge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sprintjudge
Group=sprintjudge
WorkingDirectory=/opt/sprintjudge
# SPRINTJUDGE_ADMIN_PASSWORD must be set here (prod refuses the default).
# Optional: SPRINTJUDGE_PORT, SPRINTJUDGE_CORS_ALLOWED_ORIGINS.
Environment=SPRINTJUDGE_HEAP=512m
EnvironmentFile=-/opt/sprintjudge/.env

# Fail fast with clear errors instead of crash-looping.
ExecStartPre=/usr/bin/test -x /usr/bin/java
# JDK 25 is required; Ubuntu 24.04's default JDK 21 cannot run the jar.
ExecStartPre=/bin/bash -c '/usr/bin/java -version 2>&1 | head -1 | grep -Eq "version .(2[5-9]|[3-9][0-9])"'
ExecStartPre=/usr/bin/test -x /usr/bin/nsjail

ExecStart=/usr/bin/java -XX:+UseZGC -Xms$SPRINTJUDGE_HEAP -Xmx$SPRINTJUDGE_HEAP \
  -XX:+UseStringDeduplication -XX:+PerfDisableSharedMem -XX:+UseCompactObjectHeaders \
  -jar /opt/sprintjudge/sprintjudge.jar \
  --spring.profiles.active=prod \
  --sprintjudge.executor.mode=nsjail \
  --sprintjudge.executor.nsjail-binary=/usr/bin/nsjail
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536

# Logging goes to the journal (journald); see deploy/sprintjudge.logrotate for
# the optional file-based fallback and nginx log rotation.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sprintjudge

[Install]
WantedBy=multi-user.target
