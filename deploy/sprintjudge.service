[Unit]
Description=SprintJudge
After=network.target

[Service]
Type=simple
User=sprintjudge
WorkingDirectory=/opt/sprintjudge
ExecStart=/usr/bin/java -XX:+UseZGC -Xms2g -Xmx2g \
  -XX:+UseStringDeduplication -XX:+PerfDisableSharedMem -XX:+UseCompactObjectHeaders \
  -jar /opt/sprintjudge/sprintjudge.jar \
  --spring.profiles.active=prod \
  --sprintjudge.executor.mode=nsjail
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
