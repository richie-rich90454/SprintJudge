{"id":"int3-3.1-0001","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"compute the slope of a line from two points","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A ramp rises 2 metres over a horizontal distance of 8 metres. What is its slope?","options":[{"id":"A","text":"1/4 (rise over run)","misconception":""},{"id":"B","text":"4 (inverts rise and run)","misconception":"inverts rise and run"},{"id":"C","text":"2 (uses only the rise)","misconception":"uses the rise as the slope"},{"id":"D","text":"8 (uses only the run)","misconception":"uses the run as the slope"}],"answer":{"correctId":"A"},"explanation":"Slope is rise over run, so 2 divided by 8 gives 1/4.","hint":"Rise over run.","difficulty":0.3,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":15,"medianSec":28,"p75Sec":44},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0002","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"identify slope from slope-intercept form","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"What is the slope of the line y = 3x - 7?","options":[{"id":"A","text":"3 (coefficient of x)","misconception":""},{"id":"B","text":"-7 (constant term)","misconception":"confuses intercept with slope"},{"id":"C","text":"7 (absolute constant)","misconception":"ignores the sign of intercept"},{"id":"D","text":"1/3 (reciprocal)","misconception":"takes reciprocal of slope"}],"answer":{"correctId":"A"},"explanation":"In y = mx + b, m is the slope, so the slope is 3.","hint":"Slope is the coefficient of x.","difficulty":0.2,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":10,"medianSec":20,"p75Sec":32},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0003","subject":"INTEGRATED_3","unit":"Unit 3","topic":"intercepts","learningObjective":"find the y-intercept from an equation","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"What is the y-intercept of the line y = -2x + 5?","options":[{"id":"A","text":"5 (constant term)","misconception":""},{"id":"B","text":"-2 (slope)","misconception":"confuses slope with intercept"},{"id":"C","text":"0 (origin guess)","misconception":"assumes intercept is zero"},{"id":"D","text":"2 (sign dropped)","misconception":"drops the sign of slope"}],"answer":{"correctId":"A"},"explanation":"In y = mx + b, b is the y-intercept, so it is 5.","hint":"Look at the constant term.","difficulty":0.25,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","intercepts"],"version":1},
{"id":"int3-3.1-0004","subject":"INTEGRATED_3","unit":"Unit 3","topic":"intercepts","learningObjective":"find the x-intercept of a line","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Find the x-intercept of the line y = 2x - 6.","options":[{"id":"A","text":"x = 3 (solve 0 = 2x - 6)","misconception":""},{"id":"B","text":"x = -3 (sign error)","misconception":"sign error when solving"},{"id":"C","text":"x = 6 (uses constant)","misconception":"uses constant as intercept"},{"id":"D","text":"x = -6 (slope sign)","misconception":"confuses slope with intercept"}],"answer":{"correctId":"A"},"explanation":"Set y = 0, so 0 = 2x - 6, giving x = 3.","hint":"Set y to zero and solve.","difficulty":0.35,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":15,"medianSec":26,"p75Sec":40},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","intercepts"],"version":1},
{"id":"int3-3.1-0005","subject":"INTEGRATED_3","unit":"Unit 3","topic":"linear equations","learningObjective":"solve a two-step linear equation","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Solve for x: 3x + 4 = 19.","options":[{"id":"A","text":"x = 5 (correct solution)","misconception":""},{"id":"B","text":"x = 23/3 (adds not subtracts)","misconception":"adds constant instead of subtracting"},{"id":"C","text":"x = 15/3 (subtracts wrong)","misconception":"subtracts 4 from 19 incorrectly"},{"id":"D","text":"x = 7 (divides first)","misconception":"divides before isolating x"}],"answer":{"correctId":"A"},"explanation":"Subtract 4 to get 3x = 15, then divide by 3 to get x = 5.","hint":"Isolate x step by step.","difficulty":0.3,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":34},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","linear-equations"],"version":1},
{"id":"int3-3.1-0006","subject":"INTEGRATED_3","unit":"Unit 3","topic":"linear equations","learningObjective":"solve an equation with variables on both sides","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Solve for x: 5x - 3 = 2x + 9.","options":[{"id":"A","text":"x = 4 (correct solution)","misconception":""},{"id":"B","text":"x = 2 (subtract error)","misconception":"subtracts 3 instead of 9"},{"id":"C","text":"x = 6 (add error)","misconception":"adds constants incorrectly"},{"id":"D","text":"x = 12/7 (divides wrong)","misconception":"divides by 7"}],"answer":{"correctId":"A"},"explanation":"Subtract 2x and add 3: 3x = 12, so x = 4.","hint":"Move variable terms together.","difficulty":0.4,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":18,"medianSec":30,"p75Sec":46},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","linear-equations"],"version":1},
{"id":"int3-3.1-0007","subject":"INTEGRATED_3","unit":"Unit 3","topic":"systems","learningObjective":"solve a system by substitution","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Solve the system y = 2x and x + y = 6. What is x?","options":[{"id":"A","text":"x = 2 (correct)","misconception":""},{"id":"B","text":"x = 3 (halves wrong)","misconception":"splits 6 by 2 incorrectly"},{"id":"C","text":"x = 6 (ignores y)","misconception":"ignores the second equation"},{"id":"D","text":"x = 1 (off by one)","misconception":"arithmetic slip"}],"answer":{"correctId":"A"},"explanation":"Substitute y = 2x into x + y = 6 to get 3x = 6, so x = 2.","hint":"Substitute the expression for y.","difficulty":0.35,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":15,"medianSec":28,"p75Sec":42},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","systems"],"version":1},
{"id":"int3-3.1-0008","subject":"INTEGRATED_3","unit":"Unit 3","topic":"systems","learningObjective":"classify a system of equations","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"ANALYZE","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"The lines y = 2x + 1 and y = 2x + 3 have the same slope but different intercepts. How many solutions does the system have?","options":[{"id":"A","text":"No solution (parallel lines)","misconception":""},{"id":"B","text":"One solution (intersect)","misconception":"ignores parallel condition"},{"id":"C","text":"Infinitely many (same line)","misconception":"confuses parallel with coincident"},{"id":"D","text":"Two solutions (curves)","misconception":"treats lines as curves"}],"answer":{"correctId":"A"},"explanation":"Same slope with different intercepts means parallel lines that never intersect, so no solution.","hint":"Parallel lines never meet.","difficulty":0.45,"discrimination":0.5,"responseTimeBaseline":{"p25Sec":18,"medianSec":32,"p75Sec":48},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","systems"],"version":1},
{"id":"int3-3.1-0009","subject":"INTEGRATED_3","unit":"Unit 3","topic":"graphing","learningObjective":"identify the graph of a linear equation","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Which statement describes the graph of y = -x + 4?","options":[{"id":"A","text":"Line with slope -1, y-intercept 4","misconception":""},{"id":"B","text":"Line with slope 1, y-intercept 4","misconception":"drops the negative slope"},{"id":"C","text":"Line with slope -1, y-intercept -4","misconception":"flips intercept sign"},{"id":"D","text":"Horizontal line at y = 4","misconception":"ignores the x term"}],"answer":{"correctId":"A"},"explanation":"The coefficient of x is -1 and the constant is 4, so slope -1 and y-intercept 4.","hint":"Read m and b from y = mx + b.","difficulty":0.25,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":12,"medianSec":20,"p75Sec":32},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","graphing"],"version":1},
{"id":"int3-3.1-0010","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"compute slope from standard form","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"What is the slope of the line 2x + 4y = 8?","options":[{"id":"A","text":"-1/2 (after solving for y)","misconception":""},{"id":"B","text":"1/2 (sign error)","misconception":"sign error on slope"},{"id":"C","text":"-2 (coefficient ratio)","misconception":"uses A/B instead of -A/B"},{"id":"D","text":"2 (reciprocal)","misconception":"reciprocal of slope"}],"answer":{"correctId":"A"},"explanation":"Solve for y: 4y = -2x + 8, so y = -1/2 x + 2, slope -1/2.","hint":"Rearrange to slope-intercept form.","difficulty":0.45,"discrimination":0.5,"responseTimeBaseline":{"p25Sec":20,"medianSec":34,"p75Sec":50},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0011","subject":"INTEGRATED_3","unit":"Unit 3","topic":"intercepts","learningObjective":"find intercepts from standard form","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"For the line 3x + 2y = 6, what is the y-intercept?","options":[{"id":"A","text":"y = 3 (set x = 0)","misconception":""},{"id":"B","text":"y = 2 (uses coefficient)","misconception":"uses coefficient of y"},{"id":"C","text":"y = 6 (uses constant)","misconception":"uses constant as intercept"},{"id":"D","text":"y = 0 (origin)","misconception":"assumes intercept zero"}],"answer":{"correctId":"A"},"explanation":"Set x = 0: 2y = 6, so y = 3.","hint":"Set the other variable to zero.","difficulty":0.35,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":15,"medianSec":26,"p75Sec":40},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","intercepts"],"version":1},
{"id":"int3-3.1-0012","subject":"INTEGRATED_3","unit":"Unit 3","topic":"linear equations","learningObjective":"write equation in slope-intercept form","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A line has slope 4 and y-intercept -1. Which equation represents it?","options":[{"id":"A","text":"y = 4x - 1 (slope-intercept)","misconception":""},{"id":"B","text":"y = -x + 4 (swapped)","misconception":"swaps slope and intercept"},{"id":"C","text":"y = 4x + 1 (sign error)","misconception":"sign error on intercept"},{"id":"D","text":"y = -4x - 1 (slope sign)","misconception":"flips slope sign"}],"answer":{"correctId":"A"},"explanation":"Use y = mx + b with m = 4 and b = -1 to get y = 4x - 1.","hint":"Plug m and b into y = mx + b.","difficulty":0.3,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":34},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","linear-equations"],"version":1},
{"id":"int3-3.1-0013","subject":"INTEGRATED_3","unit":"Unit 3","topic":"graphing","learningObjective":"determine direction of a line from slope sign","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A line with a negative slope goes in which direction as x increases?","options":[{"id":"A","text":"Downward from left to right","misconception":""},{"id":"B","text":"Upward from left to right","misconception":"positive slope direction"},{"id":"C","text":"Horizontal (flat)","misconception":"zero slope"},{"id":"D","text":"Vertical (straight up)","misconception":"undefined slope"}],"answer":{"correctId":"A"},"explanation":"A negative slope means y decreases as x increases, so the line falls left to right.","hint":"Negative slope means decreasing.","difficulty":0.2,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":8,"medianSec":16,"p75Sec":26},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","graphing"],"version":1},
{"id":"int3-3.1-0014","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"find slope of a horizontal line","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"What is the slope of a horizontal line?","options":[{"id":"A","text":"0 (no rise)","misconception":""},{"id":"B","text":"Undefined (no run)","misconception":"confuses with vertical line"},{"id":"C","text":"1 (unit slope)","misconception":"assumes unit slope"},{"id":"D","text":"Infinity (limit)","misconception":"misapplies limit idea"}],"answer":{"correctId":"A"},"explanation":"A horizontal line has zero rise, so slope = 0/run = 0.","hint":"Rise is zero.","difficulty":0.25,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":16,"p75Sec":26},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0015","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"find slope of a vertical line","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"What is the slope of a vertical line?","options":[{"id":"A","text":"Undefined (zero run)","misconception":""},{"id":"B","text":"0 (no rise)","misconception":"confuses with horizontal"},{"id":"C","text":"1 (unit slope)","misconception":"assumes unit slope"},{"id":"D","text":"Infinity (large number)","misconception":"uses infinity loosely"}],"answer":{"correctId":"A"},"explanation":"A vertical line has zero run, so slope = rise/0 is undefined.","hint":"Division by zero.","difficulty":0.3,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":16,"p75Sec":26},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0016","subject":"INTEGRATED_3","unit":"Unit 3","topic":"systems","learningObjective":"solve a system by elimination","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Solve: x + y = 7 and x - y = 1. What is x?","options":[{"id":"A","text":"x = 4 (add equations)","misconception":""},{"id":"B","text":"x = 3 (subtract)","misconception":"subtracts instead of adds"},{"id":"C","text":"x = 8 (add constants)","misconception":"adds constants incorrectly"},{"id":"D","text":"x = 2 (halves)","misconception":"halves the sum"}],"answer":{"correctId":"A"},"explanation":"Add the equations: 2x = 8, so x = 4.","hint":"Add to eliminate y.","difficulty":0.4,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":16,"medianSec":28,"p75Sec":42},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","systems"],"version":1},
{"id":"int3-3.1-0017","subject":"INTEGRATED_3","unit":"Unit 3","topic":"systems","learningObjective":"identify coincident lines","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"ANALYZE","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"The equations 2x + 4y = 8 and x + 2y = 4 are multiples of each other. How many solutions does the system have?","options":[{"id":"A","text":"Infinitely many (same line)","misconception":""},{"id":"B","text":"No solution (parallel)","misconception":"confuses coincident with parallel"},{"id":"C","text":"One solution (intersect)","misconception":"ignores dependency"},{"id":"D","text":"Zero solutions (inconsistent)","misconception":"mislabels consistent system"}],"answer":{"correctId":"A"},"explanation":"One equation is a multiple of the other, so they represent the same line with infinitely many solutions.","hint":"Check if equations are proportional.","difficulty":0.5,"discrimination":0.5,"responseTimeBaseline":{"p25Sec":20,"medianSec":34,"p75Sec":50},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","systems"],"version":1},
{"id":"int3-3.1-0018","subject":"INTEGRATED_3","unit":"Unit 3","topic":"graphing","learningObjective":"plot a point given coordinates","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"In which quadrant is the point (-3, 4) located?","options":[{"id":"A","text":"Quadrant II (x negative, y positive)","misconception":""},{"id":"B","text":"Quadrant I (both positive)","misconception":"ignores negative x"},{"id":"C","text":"Quadrant III (both negative)","misconception":"sign error on y"},{"id":"D","text":"Quadrant IV (x positive, y negative)","misconception":"swaps signs"}],"answer":{"correctId":"A"},"explanation":"Negative x and positive y places the point in Quadrant II.","hint":"Recall quadrant sign rules.","difficulty":0.2,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":8,"medianSec":16,"p75Sec":26},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","graphing"],"version":1},
{"id":"int3-3.1-0019","subject":"INTEGRATED_3","unit":"Unit 3","topic":"linear equations","learningObjective":"determine if a point lies on a line","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Does the point (2, 5) lie on the line y = 2x + 1?","options":[{"id":"A","text":"Yes (5 = 2*2 + 1)","misconception":""},{"id":"B","text":"No (5 != 2*2)","misconception":"forgets to add 1"},{"id":"C","text":"No (5 != 2 + 1)","misconception":"multiplies wrong"},{"id":"D","text":"Yes (5 = 2 + 2 + 1)","misconception":"adds x twice"}],"answer":{"correctId":"A"},"explanation":"Substitute x = 2: y = 2(2) + 1 = 5, which matches, so yes.","hint":"Substitute the point into the equation.","difficulty":0.3,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":34},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","linear-equations"],"version":1},
{"id":"int3-3.1-0020","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"compute slope from two points","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Find the slope of the line through (1, 2) and (5, 10).","options":[],"answer":{"value":2,"tolerance":0.001},"explanation":"Slope = (10 - 2)/(5 - 1) = 8/4 = 2.","hint":"(y2 - y1)/(x2 - x1).","difficulty":0.35,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":15,"medianSec":28,"p75Sec":44},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0021","subject":"INTEGRATED_3","unit":"Unit 3","topic":"intercepts","learningObjective":"compute y-intercept numerically","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"For the line y = 3x - 9, what is the y-intercept value?","options":[],"answer":{"value":-9,"tolerance":0.001},"explanation":"The constant term is -9, so the y-intercept is -9.","hint":"Constant term.","difficulty":0.25,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","intercepts"],"version":1},
{"id":"int3-3.1-0022","subject":"INTEGRATED_3","unit":"Unit 3","topic":"systems","learningObjective":"solve a system for y","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Solve the system y = x + 1 and 2x + y = 7. What is y?","options":[],"answer":{"value":3,"tolerance":0.001},"explanation":"Substitute: 2x + (x + 1) = 7, so 3x = 6, x = 2, and y = 3.","hint":"Substitute and solve.","difficulty":0.4,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":18,"medianSec":30,"p75Sec":46},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","systems"],"version":1},
{"id":"int3-3.1-0023","subject":"INTEGRATED_3","unit":"Unit 3","topic":"linear equations","learningObjective":"solve an equation with fractions","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Solve for x: (1/2)x - 3 = 5.","options":[{"id":"A","text":"x = 16 (multiply by 2)","misconception":""},{"id":"B","text":"x = 8 (add 3 only)","misconception":"forgets to multiply by 2"},{"id":"C","text":"x = 10 (subtract wrong)","misconception":"subtracts incorrectly"},{"id":"D","text":"x = 4 (divides by 2)","misconception":"divides instead of multiplies"}],"answer":{"correctId":"A"},"explanation":"Add 3: (1/2)x = 8, then multiply by 2: x = 16.","hint":"Clear the fraction last.","difficulty":0.45,"discrimination":0.5,"responseTimeBaseline":{"p25Sec":18,"medianSec":30,"p75Sec":46},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","linear-equations"],"version":1},
{"id":"int3-3.1-0024","subject":"INTEGRATED_3","unit":"Unit 3","topic":"graphing","learningObjective":"relate slope to rate of change","practice":"application","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A car travels 120 km in 2 hours. What is the rate of change (slope) in km per hour?","options":[{"id":"A","text":"60 km/h (distance/time)","misconception":""},{"id":"B","text":"240 km/h (multiplies)","misconception":"multiplies instead of divides"},{"id":"C","text":"2 km/h (uses time)","misconception":"uses time as slope"},{"id":"D","text":"120 km/h (uses distance)","misconception":"uses distance as slope"}],"answer":{"correctId":"A"},"explanation":"Rate of change = 120/2 = 60 km/h.","hint":"Divide distance by time.","difficulty":0.3,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":34},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","graphing"],"version":1},
{"id":"int3-3.1-0025","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"determine parallel lines","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"ANALYZE","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Which line is parallel to y = 3x + 2?","options":[{"id":"A","text":"y = 3x - 5 (same slope)","misconception":""},{"id":"B","text":"y = -3x + 2 (negative slope)","misconception":"negates slope"},{"id":"C","text":"y = (1/3)x + 2 (reciprocal)","misconception":"takes reciprocal slope"},{"id":"D","text":"y = 2x + 3 (different slope)","misconception":"changes slope"}],"answer":{"correctId":"A"},"explanation":"Parallel lines have equal slopes; y = 3x - 5 has slope 3.","hint":"Same slope means parallel.","difficulty":0.4,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":15,"medianSec":26,"p75Sec":40},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0026","subject":"INTEGRATED_3","unit":"Unit 3","topic":"slope","learningObjective":"determine perpendicular slope","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"What is the slope of a line perpendicular to a line with slope 2?","options":[{"id":"A","text":"-1/2 (negative reciprocal)","misconception":""},{"id":"B","text":"1/2 (reciprocal only)","misconception":"forgets negative sign"},{"id":"C","text":"-2 (negative only)","misconception":"negates but not reciprocal"},{"id":"D","text":"2 (same slope)","misconception":"parallel not perpendicular"}],"answer":{"correctId":"A"},"explanation":"Perpendicular slopes are negative reciprocals: -1/2.","hint":"Negative reciprocal.","difficulty":0.45,"discrimination":0.5,"responseTimeBaseline":{"p25Sec":15,"medianSec":28,"p75Sec":42},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","slope"],"version":1},
{"id":"int3-3.1-0027","subject":"INTEGRATED_3","unit":"Unit 3","topic":"systems","learningObjective":"solve a system with no solution","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"ANALYZE","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"The system y = 2x + 1 and 4x - 2y = 3 has no solution. Which statement is true?","options":[{"id":"A","text":"Lines are parallel (same slope)","misconception":""},{"id":"B","text":"Lines are identical (same line)","misconception":"confuses inconsistent with dependent"},{"id":"C","text":"Lines intersect at origin","misconception":"assumes origin solution"},{"id":"D","text":"One line is vertical","misconception":"misreads standard form"}],"answer":{"correctId":"A"},"explanation":"Rewrite 4x - 2y = 3 as y = 2x - 3/2, same slope 2 but different intercept, so parallel.","hint":"Compare slopes and intercepts.","difficulty":0.55,"discrimination":0.55,"responseTimeBaseline":{"p25Sec":22,"medianSec":36,"p75Sec":52},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","systems"],"version":1},
{"id":"int3-3.1-0028","subject":"INTEGRATED_3","unit":"Unit 3","topic":"linear equations","learningObjective":"solve an equation with distribution","practice":"computation","scope":"core-scope","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Solve for x: 2(x + 3) = 14.","options":[{"id":"A","text":"x = 4 (distribute then solve)","misconception":""},{"id":"B","text":"x = 7 (divide first)","misconception":"divides before distributing"},{"id":"C","text":"x = 11 (subtract 3)","misconception":"subtracts 3 only"},{"id":"D","text":"x = 5 (add error)","misconception":"arithmetic slip"}],"answer":{"correctId":"A"},"explanation":"Distribute: 2x + 6 = 14, so 2x = 8 and x = 4.","hint":"Distribute first.","difficulty":0.35,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":15,"medianSec":26,"p75Sec":40},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","linear-equations"],"version":1},
{"id":"int3-3.1-0029","subject":"INTEGRATED_3","unit":"Unit 3","topic":"intercepts","learningObjective":"use intercepts to graph","practice":"conceptual","scope":"core-scope","cognitiveDemand":{"bloom":"UNDERSTAND","dok":1},"format":"CONCEPT_MCQ","stimulus":null,"stem":"To graph a line using intercepts, which two points are typically used?","options":[{"id":"A","text":"The x-intercept and y-intercept","misconception":""},{"id":"B","text":"The slope and y-intercept","misconception":"confuses slope with point"},{"id":"C","text":"Two arbitrary y-values","misconception":"not standard intercept method"},{"id":"D","text":"The origin and slope","misconception":"origin not required"}],"answer":{"correctId":"A"},"explanation":"The intercept method uses the x- and y-intercepts as the two points to draw the line.","hint":"Intercepts are where axes are crossed.","difficulty":0.25,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","intercepts"],"version":1},
{"id":"int3-3.1-0030","subject":"INTEGRATED_3","unit":"Unit 3","topic":"graphing","learningObjective":"interpret a linear graph","practice":"analysis","scope":"core-scope","cognitiveDemand":{"bloom":"ANALYZE","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A line on a graph passes through (0, 2) and (4, 10). What is its equation?","options":[{"id":"A","text":"y = 2x + 2 (slope 2, intercept 2)","misconception":""},{"id":"B","text":"y = 4x + 2 (uses run as slope)","misconception":"uses run as slope"},{"id":"C","text":"y = 2x + 4 (uses x of point)","misconception":"uses point coordinate as intercept"},{"id":"D","text":"y = 8x + 2 (uses rise as slope)","misconception":"uses rise as slope"}],"answer":{"correctId":"A"},"explanation":"Slope = (10-2)/(4-0) = 2 and y-intercept = 2, so y = 2x + 2.","hint":"Compute slope then intercept.","difficulty":0.6,"discrimination":0.55,"responseTimeBaseline":{"p25Sec":22,"medianSec":38,"p75Sec":56},"provenance":{"author":"bank-team-i3","reviewer":"bank-review-i3","reviewedAt":"2026-09-18T00:00:00Z","aiAssisted":true,"aiModel":"muse-spark","aiRunId":"sprint2-bank-fill","humanReviewer":"orchestrator-spotcheck","stimulusLicense":null,"fairUseRationale":null,"attestation":"authored from first principles; no protected content used"},"relatedQuestionIds":[],"prerequisiteQuestionIds":[],"tags":["unit-3","graphing"],"version":1}
