{"id":"mech-2.2-0001","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPTUAL_REASONING","stimulus":null,"stem":"A puck slides on frictionless ice. What happens to its velocity?","options":[{"id":"A","text":"Stays constant","misconception":""},{"id":"B","text":"Slows to a stop","misconception":"assumes friction always present"},{"id":"C","text":"Speeds up","misconception":"assumes motion needs force"},{"id":"D","text":"Oscillates","misconception":"invents periodic motion"}],"answer":{"correctId":"A"},"explanation":"With no net force, velocity remains constant by Newton's first law.","hint":"No net force means constant velocity.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0002","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Which object has the greatest inertia?","options":[{"id":"A","text":"A truck","misconception":""},{"id":"B","text":"A bicycle","misconception":"confuses speed with inertia"},{"id":"C","text":"A feather","misconception":"confuses lightness with inertia"},{"id":"D","text":"A rolling ball","misconception":"confuses motion with inertia"}],"answer":{"correctId":"A"},"explanation":"Inertia is proportional to mass, so the truck has greatest inertia.","hint":"Inertia increases with mass.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0003","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"When you push a wall, the wall pushes back with?","options":[{"id":"A","text":"Equal and opposite force","misconception":""},{"id":"B","text":"Greater force","misconception":"thinks wall overpowers"},{"id":"C","text":"Lesser force","misconception":"thinks you overpower wall"},{"id":"D","text":"No force","misconception":"denies reaction"}],"answer":{"correctId":"A"},"explanation":"Newton's third law gives equal and opposite reaction force.","hint":"Action and reaction are equal and opposite.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0004","topic":"Friction","learningObjective":"Explain the role of friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Friction between surfaces acts to?","options":[{"id":"A","text":"Oppose relative motion","misconception":""},{"id":"B","text":"Increase speed","misconception":"confuses friction with thrust"},{"id":"C","text":"Eliminate mass","misconception":"nonsense"},{"id":"D","text":"Create energy","misconception":"violates conservation"}],"answer":{"correctId":"A"},"explanation":"Friction opposes relative motion between surfaces.","hint":"Friction opposes motion.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0005","topic":"Free fall","learningObjective":"Describe free-fall acceleration","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"In free fall (no air), acceleration is?","options":[{"id":"A","text":"g downward for all masses","misconception":""},{"id":"B","text":"Larger for heavier objects","misconception":"mass dependence error"},{"id":"C","text":"Zero","misconception":"confuses free fall with float"},{"id":"D","text":"Depends on shape","misconception":"air-resistance thinking"}],"answer":{"correctId":"A"},"explanation":"Free-fall acceleration is g downward independent of mass.","hint":"All objects fall with g.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0006","topic":"Newton's second law","learningObjective":"Apply F=ma","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Force 20 N on mass 4 kg. Acceleration?","answer":{"value":5,"tolerance":0.01},"explanation":"a = F/m = 20/4 = 5 m/s^2.","hint":"Divide force by mass.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0007","topic":"Weight","learningObjective":"Compute weight from mass","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Mass 3 kg. Weight on Earth (g=10)?","answer":{"value":30,"tolerance":0.01},"explanation":"W = mg = 3*10 = 30 N.","hint":"Multiply mass by g.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0008","topic":"Inclined planes","learningObjective":"Analyze forces on an inclined plane","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"On a frictionless incline, acceleration along plane is?","options":[{"id":"A","text":"g sinθ","misconception":""},{"id":"B","text":"g cosθ","misconception":"uses wrong component"},{"id":"C","text":"g","misconception":"ignores incline"},{"id":"D","text":"0","misconception":"confuses with equilibrium"}],"answer":{"correctId":"A"},"explanation":"Component of gravity along the plane is mg sinθ, so a = g sinθ.","hint":"Use the parallel component of gravity.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0009","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says a moving object needs continuous force to keep moving. What is wrong?","options":[{"id":"A","text":"Force changes velocity; motion continues without it","misconception":""},{"id":"B","text":"Objects stop immediately without force","misconception":"Aristotelian view"},{"id":"C","text":"Force is always zero in motion","misconception":"denies forces exist"},{"id":"D","text":"Speed equals force","misconception":"confuses quantities"}],"answer":{"correctId":"A"},"explanation":"Force changes velocity; in absence of net force motion continues (Newton's first law).","hint":"Force changes motion, not sustains it.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":15,"medianSec":30,"p75Sec":50}}
{"id":"mech-2.2-0010","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPTUAL_REASONING","stimulus":null,"stem":"In deep space, far from gravity, mass still measures?","options":[{"id":"A","text":"Inertia","misconception":""},{"id":"B","text":"Weight","misconception":"confuses mass with weight"},{"id":"C","text":"Speed","misconception":"confuses mass with motion"},{"id":"D","text":"Nothing","misconception":"denies mass in space"}],"answer":{"correctId":"A"},"explanation":"Mass measures inertia regardless of gravity; weight requires gravity.","hint":"Mass is inertia, independent of gravity.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0011","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says action and reaction cancel because they are equal and opposite. What is wrong?","options":[{"id":"A","text":"They act on different bodies, so they do not cancel","misconception":""},{"id":"B","text":"They are not really equal","misconception":"denies third law"},{"id":"C","text":"They cancel only in vacuum","misconception":"adds irrelevant condition"},{"id":"D","text":"Forces never cancel","misconception":"denies equilibrium"}],"answer":{"correctId":"A"},"explanation":"Action and reaction act on different objects, so they do not cancel on one body.","hint":"Action-reaction pairs act on different bodies.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":15,"medianSec":30,"p75Sec":50}}
{"id":"mech-2.2-0012","topic":"Friction","learningObjective":"Compare static and kinetic friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Typically, static friction is?","options":[{"id":"A","text":"Greater than kinetic friction","misconception":""},{"id":"B","text":"Less than kinetic friction","misconception":"reverses inequality"},{"id":"C","text":"Equal to kinetic friction","misconception":"ignores difference"},{"id":"D","text":"Zero","misconception":"denies static friction"}],"answer":{"correctId":"A"},"explanation":"Static friction maximum exceeds kinetic friction for same surfaces.","hint":"Static friction is usually larger.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0013","topic":"Free fall","learningObjective":"Compute free-fall distance","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Object dropped from rest for 3 s (g=10). Distance fallen?","answer":{"value":45,"tolerance":0.01},"explanation":"d = 0.5*g*t^2 = 0.5*10*9 = 45 m.","hint":"Use half g t squared.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0014","topic":"Newton's second law","learningObjective":"Apply F=ma with multiple forces","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Net force 12 N on 3 kg. Acceleration?","answer":{"value":4,"tolerance":0.01},"explanation":"a = 12/3 = 4 m/s^2.","hint":"Divide net force by mass.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0015","topic":"Weight","learningObjective":"Distinguish mass and weight","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"An astronaut's mass on the Moon compared to Earth is?","options":[{"id":"A","text":"Same","misconception":""},{"id":"B","text":"Less","misconception":"confuses mass with weight"},{"id":"C","text":"More","misconception":"reverses relation"},{"id":"D","text":"Zero","misconception":"denies mass in space"}],"answer":{"correctId":"A"},"explanation":"Mass is intrinsic and unchanged; weight changes with gravity.","hint":"Mass does not change with location.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0016","topic":"Inclined planes","learningObjective":"Resolve forces on an incline","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":3},"format":"NUMERIC","stimulus":null,"stem":"Incline angle 30°, g=10. Component of g along plane?","answer":{"value":5,"tolerance":0.01},"explanation":"g sin30 = 10*0.5 = 5 m/s^2.","hint":"Multiply g by sinθ.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0017","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A book on a table is at rest because?","options":[{"id":"A","text":"Net force is zero","misconception":""},{"id":"B","text":"No forces act on it","misconception":"ignores gravity and normal"},{"id":"C","text":"Gravity is zero","misconception":"denies gravity"},{"id":"D","text":"Friction alone holds it","misconception":"overattributes to friction"}],"answer":{"correctId":"A"},"explanation":"Gravity and normal force cancel, net force zero, so it stays at rest.","hint":"Net force determines acceleration.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0018","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Force 10 N gives acceleration 2 m/s^2. Mass?","answer":{"value":5,"tolerance":0.01},"explanation":"m = F/a = 10/2 = 5 kg.","hint":"Divide force by acceleration.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0019","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPTUAL_REASONING","stimulus":null,"stem":"A horse pulls a cart. The cart pulls the horse with?","options":[{"id":"A","text":"Equal and opposite force","misconception":""},{"id":"B","text":"Smaller force","misconception":"thinks cart is passive"},{"id":"C","text":"Greater force","misconception":"thinks horse dominates"},{"id":"D","text":"No force","misconception":"denies reaction"}],"answer":{"correctId":"A"},"explanation":"Action-reaction pair: cart pulls horse equally and oppositely.","hint":"Forces come in equal pairs.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0020","topic":"Friction","learningObjective":"Compute friction force","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"μ=0.2, normal force 50 N. Friction force?","answer":{"value":10,"tolerance":0.01},"explanation":"f = μN = 0.2*50 = 10 N.","hint":"Multiply coefficient by normal force.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0021","topic":"Free fall","learningObjective":"Compute free-fall velocity","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Dropped from rest for 2 s (g=10). Speed?","answer":{"value":20,"tolerance":0.01},"explanation":"v = gt = 10*2 = 20 m/s.","hint":"Multiply g by time.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0022","topic":"Newton's second law","learningObjective":"Apply F=ma with net force","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"If mass doubles and force stays same, acceleration?","options":[{"id":"A","text":"Halves","misconception":""},{"id":"B","text":"Doubles","misconception":"direct proportion error"},{"id":"C","text":"Stays same","misconception":"ignores mass change"},{"id":"D","text":"Quadruples","misconception":"squares relation"}],"answer":{"correctId":"A"},"explanation":"a = F/m, so doubling m halves a.","hint":"Acceleration is inversely proportional to mass.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0023","topic":"Weight","learningObjective":"Compute weight on different planets","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Same mass on Moon (g=1.6) vs Earth (g=10). Weight on Moon is?","options":[{"id":"A","text":"Less","misconception":""},{"id":"B","text":"Same","misconception":"confuses mass with weight"},{"id":"C","text":"Greater","misconception":"reverses relation"},{"id":"D","text":"Zero","misconception":"denies gravity on Moon"}],"answer":{"correctId":"A"},"explanation":"Weight = mg, so smaller g gives smaller weight.","hint":"Weight scales with g.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0024","topic":"Inclined planes","learningObjective":"Analyze forces on an inclined plane","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says normal force on an incline equals mg. What is wrong?","options":[{"id":"A","text":"Normal force is mg cosθ on an incline","misconception":""},{"id":"B","text":"Normal force is mg sinθ","misconception":"uses parallel component"},{"id":"C","text":"Normal force is zero on incline","misconception":"denies contact"},{"id":"D","text":"Normal force equals weight always","misconception":"ignores angle"}],"answer":{"correctId":"A"},"explanation":"Perpendicular component of weight is mg cosθ, so normal force is mg cosθ.","hint":"Use perpendicular component.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0025","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Inertia is a property of?","options":[{"id":"A","text":"Mass","misconception":""},{"id":"B","text":"Speed","misconception":"confuses inertia with motion"},{"id":"C","text":"Force","misconception":"confuses inertia with force"},{"id":"D","text":"Gravity","misconception":"confuses inertia with weight"}],"answer":{"correctId":"A"},"explanation":"Inertia is resistance to change in motion and is proportional to mass.","hint":"Inertia is tied to mass.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0026","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says a fast light object has more inertia than a slow heavy one. What is wrong?","options":[{"id":"A","text":"Inertia depends on mass, not speed","misconception":""},{"id":"B","text":"Speed reduces inertia","misconception":"invents speed dependence"},{"id":"C","text":"Light objects have more inertia","misconception":"reverses mass relation"},{"id":"D","text":"Inertia depends on force","misconception":"confuses with force"}],"answer":{"correctId":"A"},"explanation":"Inertia depends only on mass, not speed.","hint":"Inertia is mass-dependent only.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0027","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Action and reaction forces are?","options":[{"id":"A","text":"Equal in magnitude, opposite in direction","misconception":""},{"id":"B","text":"Unequal","misconception":"denies equality"},{"id":"C","text":"Same direction","misconception":"denies opposition"},{"id":"D","text":"Zero","misconception":"denies forces"}],"answer":{"correctId":"A"},"explanation":"Newton's third law: equal magnitude, opposite direction.","hint":"Equal and opposite.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0028","topic":"Friction","learningObjective":"Explain the role of friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says friction disappears in vacuum. What is wrong?","options":[{"id":"A","text":"Friction is contact force, independent of air","misconception":""},{"id":"B","text":"Vacuum eliminates all forces","misconception":"denies forces in vacuum"},{"id":"C","text":"Friction needs air to exist","misconception":"confuses friction with drag"},{"id":"D","text":"Vacuum increases friction","misconception":"invents relation"}],"answer":{"correctId":"A"},"explanation":"Friction arises from contact between surfaces, not from air.","hint":"Friction is a contact force.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0029","topic":"Free fall","learningObjective":"Describe free-fall acceleration","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPTUAL_REASONING","stimulus":null,"stem":"In free fall, distance fallen in first second (g=10) is?","options":[{"id":"A","text":"5 m","misconception":""},{"id":"B","text":"10 m","misconception":"uses g*t without half"},{"id":"C","text":"20 m","misconception":"doubles"},{"id":"D","text":"0 m","misconception":"denies fall"}],"answer":{"correctId":"A"},"explanation":"d = 0.5*g*t^2 = 0.5*10*1 = 5 m.","hint":"Use half g t squared.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0030","topic":"Newton's second law","learningObjective":"Apply F=ma","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Mass 6 kg, acceleration 2 m/s^2. Net force?","answer":{"value":12,"tolerance":0.01},"explanation":"F = ma = 6*2 = 12 N.","hint":"Multiply mass by acceleration.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0031","topic":"Weight","learningObjective":"Compute weight from mass","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Mass 5 kg, g=9.8. Weight?","answer":{"value":49,"tolerance":0.01},"explanation":"W = 5*9.8 = 49 N.","hint":"Multiply mass by g.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0032","topic":"Inclined planes","learningObjective":"Analyze forces on an inclined plane","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"On a frictionless incline, if angle increases, acceleration?","options":[{"id":"A","text":"Increases","misconception":""},{"id":"B","text":"Decreases","misconception":"reverses relation"},{"id":"C","text":"Stays same","misconception":"ignores angle"},{"id":"D","text":"Becomes zero","misconception":"confuses with flat"}],"answer":{"correctId":"A"},"explanation":"a = g sinθ, and sinθ increases with θ up to 90°.","hint":"Acceleration scales with sinθ.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0033","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A net force of zero on an object means?","options":[{"id":"A","text":"Constant velocity (possibly zero)","misconception":""},{"id":"B","text":"Object must be at rest","misconception":"ignores moving equilibrium"},{"id":"C","text":"Acceleration is infinite","misconception":"nonsense"},{"id":"D","text":"Mass is zero","misconception":"confuses force with mass"}],"answer":{"correctId":"A"},"explanation":"Zero net force means zero acceleration, so velocity stays constant (could be nonzero).","hint":"Zero net force means no acceleration.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0034","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Which has more inertia: 2 kg at rest or 2 kg moving at 10 m/s?","options":[{"id":"A","text":"Both same","misconception":""},{"id":"B","text":"Moving one","misconception":"speed adds inertia"},{"id":"C","text":"Resting one","misconception":"rest adds inertia"},{"id":"D","text":"Neither has inertia","misconception":"denies inertia"}],"answer":{"correctId":"A"},"explanation":"Inertia depends only on mass, so both have equal inertia.","hint":"Inertia is mass only.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0035","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Earth pulls apple; apple pulls Earth. Which force is larger?","options":[{"id":"A","text":"Equal","misconception":""},{"id":"B","text":"Earth on apple","misconception":"thinks bigger body exerts more"},{"id":"C","text":"Apple on Earth","misconception":"thinks falling object dominates"},{"id":"D","text":"Depends on distance","misconception":"adds irrelevant variable"}],"answer":{"correctId":"A"},"explanation":"Third law: the two forces are equal in magnitude.","hint":"Action-reaction equal in magnitude.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0036","topic":"Friction","learningObjective":"Explain the role of friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Friction is?","options":[{"id":"A","text":"A contact force","misconception":""},{"id":"B","text":"An action-at-a-distance force","misconception":"confuses with gravity"},{"id":"C","text":"Massless","misconception":"nonsense"},{"id":"D","text":"Always zero","misconception":"denies friction"}],"answer":{"correctId":"A"},"explanation":"Friction requires contact between surfaces.","hint":"Friction is contact force.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0037","topic":"Free fall","learningObjective":"Describe free-fall acceleration","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says a heavy ball falls faster than a light ball in vacuum. What is wrong?","options":[{"id":"A","text":"Free-fall acceleration is independent of mass","misconception":""},{"id":"B","text":"Heavy objects have less inertia","misconception":"inertia reduces fall"},{"id":"C","text":"Light objects accelerate more","misconception":"inverse mass error"},{"id":"D","text":"Vacuum changes g","misconception":"medium affects g"}],"answer":{"correctId":"A"},"explanation":"In vacuum all objects fall with acceleration g regardless of mass.","hint":"Mass does not affect free fall.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0038","topic":"Newton's second law","learningObjective":"Apply F=ma","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student uses F = m/a. What is wrong?","options":[{"id":"A","text":"Should be F = m*a, not m/a","misconception":""},{"id":"B","text":"Force should be divided by mass","misconception":"inverts relation"},{"id":"C","text":"Acceleration should be squared","misconception":"squares acceleration"},{"id":"D","text":"No formula exists","misconception":"denies kinematics"}],"answer":{"correctId":"A"},"explanation":"Newton's second law is F = ma, product not quotient.","hint":"Force equals mass times acceleration.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0039","topic":"Weight","learningObjective":"Distinguish mass and weight","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"ERROR_ANALYSIS","stimulus":null,"stem":"A student says mass and weight are the same quantity. What is wrong?","options":[{"id":"A","text":"Mass is intrinsic; weight depends on gravity","misconception":""},{"id":"B","text":"They are always equal numerically","misconception":"ignores units"},{"id":"C","text":"Weight is massless","misconception":"nonsense"},{"id":"D","text":"Mass requires gravity","misconception":"confuses mass with weight"}],"answer":{"correctId":"A"},"explanation":"Mass is intrinsic; weight = mg depends on gravitational field.","hint":"Mass and weight differ.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":12,"medianSec":22,"p75Sec":38}}
{"id":"mech-2.2-0040","topic":"Inclined planes","learningObjective":"Analyze forces on an inclined plane","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":3},"format":"NUMERIC","stimulus":null,"stem":"Incline 90°, g=10. Acceleration along plane (frictionless)?","answer":{"value":10,"tolerance":0.01},"explanation":"a = g sin90 = 10*1 = 10 m/s^2 (free fall).","hint":"sin90 = 1.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0041","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Seatbelts are needed because of?","options":[{"id":"A","text":"Inertia","misconception":""},{"id":"B","text":"Friction","misconception":"confuses with friction"},{"id":"C","text":"Gravity","misconception":"confuses with gravity"},{"id":"D","text":"Acceleration of car","misconception":"confuses cause"}],"answer":{"correctId":"A"},"explanation":"Inertia keeps occupants moving when car stops; seatbelt provides force.","hint":"Inertia keeps you moving.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0042","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Inertia is greatest for?","options":[{"id":"A","text":"Most massive object","misconception":""},{"id":"B","text":"Fastest object","misconception":"speed dependence"},{"id":"C","text":"Smallest object","misconception":"reverses relation"},{"id":"D","text":"Lightest object","misconception":"confuses lightness"}],"answer":{"correctId":"A"},"explanation":"Inertia proportional to mass.","hint":"More mass means more inertia.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0043","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Rocket propulsion works by?","options":[{"id":"A","text":"Expelling gas, reaction pushes rocket","misconception":""},{"id":"B","text":"Pushing against air","misconception":"needs air"},{"id":"C","text":"Gravity alone","misconception":"confuses with gravity"},{"id":"D","text":"Friction","misconception":"confuses with friction"}],"answer":{"correctId":"A"},"explanation":"Expelled gas exerts equal opposite reaction force on rocket.","hint":"Action-reaction with expelled gas.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0044","topic":"Friction","learningObjective":"Explain the role of friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Walking is possible because of?","options":[{"id":"A","text":"Friction between foot and ground","misconception":""},{"id":"B","text":"Gravity alone","misconception":"ignores contact"},{"id":"C","text":"Inertia","misconception":"confuses with inertia"},{"id":"D","text":"Air resistance","misconception":"confuses with drag"}],"answer":{"correctId":"A"},"explanation":"Friction provides the horizontal force to push off the ground.","hint":"Friction enables push-off.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0045","topic":"Free fall","learningObjective":"Describe free-fall acceleration","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Free fall acceleration near Earth's surface is approximately?","options":[{"id":"A","text":"9.8 m/s^2 downward","misconception":""},{"id":"B","text":"9.8 m/s upward","misconception":"wrong direction"},{"id":"C","text":"0 m/s^2","misconception":"confuses with orbit"},{"id":"D","text":"1 m/s^2","misconception":"wrong magnitude"}],"answer":{"correctId":"A"},"explanation":"g ≈ 9.8 m/s^2 downward near Earth.","hint":"g is about 9.8 downward.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0046","topic":"Newton's second law","learningObjective":"Apply F=ma","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Same force on smaller mass gives?","options":[{"id":"A","text":"Larger acceleration","misconception":""},{"id":"B","text":"Smaller acceleration","misconception":"reverses relation"},{"id":"C","text":"Same acceleration","misconception":"ignores mass"},{"id":"D","text":"Zero acceleration","misconception":"confuses with equilibrium"}],"answer":{"correctId":"A"},"explanation":"a = F/m, smaller m gives larger a.","hint":"Acceleration inversely proportional to mass.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0047","topic":"Weight","learningObjective":"Compute weight from mass","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Mass 10 kg, g=10. Weight?","answer":{"value":100,"tolerance":0.01},"explanation":"W = 10*10 = 100 N.","hint":"Multiply mass by g.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0048","topic":"Inclined planes","learningObjective":"Analyze forces on an inclined plane","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":3},"format":"CONCEPT_MCQ","stimulus":null,"stem":"On an incline, as θ→0, acceleration along plane?","options":[{"id":"A","text":"Approaches 0","misconception":""},{"id":"B","text":"Approaches g","misconception":"confuses with θ=90"},{"id":"C","text":"Approaches infinity","misconception":"nonsense"},{"id":"D","text":"Stays g/2","misconception":"invents value"}],"answer":{"correctId":"A"},"explanation":"a = g sinθ → 0 as θ→0.","hint":"sinθ→0 as θ→0.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0049","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"An object in equilibrium has?","options":[{"id":"A","text":"Zero net force","misconception":""},{"id":"B","text":"Zero mass","misconception":"confuses with mass"},{"id":"C","text":"Zero velocity only","misconception":"ignores moving equilibrium"},{"id":"D","text":"Infinite inertia","misconception":"nonsense"}],"answer":{"correctId":"A"},"explanation":"Equilibrium means net force zero, so acceleration zero (velocity constant).","hint":"Equilibrium means zero net force.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0050","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Doubling mass while keeping force same changes inertia how?","options":[{"id":"A","text":"Doubles","misconception":""},{"id":"B","text":"Halves","misconception":"reverses"},{"id":"C","text":"Unchanged","misconception":"ignores mass"},{"id":"D","text":"Quadruples","misconception":"squares"}],"answer":{"correctId":"A"},"explanation":"Inertia ∝ mass, so doubling mass doubles inertia.","hint":"Inertia scales with mass.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0051","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Action and reaction forces act on?","options":[{"id":"A","text":"Different objects","misconception":""},{"id":"B","text":"Same object","misconception":"confuses with balanced forces"},{"id":"C","text":"No objects","misconception":"denies forces"},{"id":"D","text":"Only massless objects","misconception":"adds condition"}],"answer":{"correctId":"A"},"explanation":"Action-reaction pairs act on different objects.","hint":"Different bodies.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0052","topic":"Friction","learningObjective":"Explain the role of friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Friction direction is always?","options":[{"id":"A","text":"Opposite relative motion or attempted motion","misconception":""},{"id":"B","text":"Along motion","misconception":"confuses with thrust"},{"id":"C","text":"Perpendicular to surface only","misconception":"confuses with normal"},{"id":"D","text":"Random","misconception":"denies pattern"}],"answer":{"correctId":"A"},"explanation":"Friction opposes relative motion or attempted relative motion.","hint":"Friction opposes motion.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0053","topic":"Free fall","learningObjective":"Describe free-fall acceleration","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"In free fall, velocity?","options":[{"id":"A","text":"Increases downward","misconception":""},{"id":"B","text":"Stays zero","misconception":"confuses with rest"},{"id":"C","text":"Decreases","misconception":"sign error"},{"id":"D","text":"Oscillates","misconception":"invents motion"}],"answer":{"correctId":"A"},"explanation":"Gravity accelerates the object downward, increasing downward velocity.","hint":"Velocity increases in direction of g.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0054","topic":"Newton's second law","learningObjective":"Apply F=ma","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"NUMERIC","stimulus":null,"stem":"Net force 15 N on 5 kg. Acceleration?","answer":{"value":3,"tolerance":0.01},"explanation":"a = 15/5 = 3 m/s^2.","hint":"Divide force by mass.","difficulty":0.65,"discrimination":0.25,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0055","topic":"Weight","learningObjective":"Compute weight from mass","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Weight is measured in?","options":[{"id":"A","text":"Newtons","misconception":""},{"id":"B","text":"Kilograms","misconception":"confuses with mass units"},{"id":"C","text":"Meters","misconception":"confuses with length"},{"id":"D","text":"Seconds","misconception":"confuses with time"}],"answer":{"correctId":"A"},"explanation":"Weight is a force, measured in newtons.","hint":"Weight is a force.","difficulty":0.75,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0056","topic":"Inclined planes","learningObjective":"Analyze forces on an inclined plane","practice":"clinician note","cognitiveDemand":{"bloom":"APPLY","dok":3},"format":"NUMERIC","stimulus":null,"stem":"Incline 60°, g=10. Component along plane?","answer":{"value":8.66,"tolerance":0.01},"explanation":"g sin60 = 10*0.866 = 8.66 m/s^2.","hint":"Multiply g by sin60.","difficulty":0.85,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
{"id":"mech-2.2-0057","topic":"Newton's first law","learningObjective":"Apply Newton's first law to motion","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"A hockey puck on frictionless ice continues moving because?","options":[{"id":"A","text":"No net force acts on it","misconception":""},{"id":"B","text":"Friction keeps it going","misconception":"confuses friction with inertia"},{"id":"C","text":"Gravity pushes it","misconception":"confuses gravity with motion"},{"id":"D","text":"It has no mass","misconception":"denies mass"}],"answer":{"correctId":"A"},"explanation":"With no net force, velocity remains constant.","hint":"No net force means constant velocity.","difficulty":0.25,"discrimination":0.3,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0058","topic":"Mass and inertia","learningObjective":"Relate mass to inertia","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Mass is a measure of?","options":[{"id":"A","text":"Inertia","misconception":""},{"id":"B","text":"Weight","misconception":"confuses mass with weight"},{"id":"C","text":"Speed","misconception":"confuses with motion"},{"id":"D","text":"Force","misconception":"confuses with force"}],"answer":{"correctId":"A"},"explanation":"Mass quantifies inertia.","hint":"Mass measures inertia.","difficulty":0.35,"discrimination":0.35,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0059","topic":"Newton's third law","learningObjective":"Identify action-reaction pairs","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"In a collision, the force on object A by B and on B by A are?","options":[{"id":"A","text":"Equal and opposite","misconception":""},{"id":"B","text":"Larger on heavier object","misconception":"mass affects force"},{"id":"C","text":"Larger on faster object","misconception":"speed affects force"},{"id":"D","text":"Zero","misconception":"denies forces"}],"answer":{"correctId":"A"},"explanation":"Third law: equal and opposite forces.","hint":"Equal and opposite.","difficulty":0.45,"discrimination":0.4,"responseTimeBaseline":{"p25Sec":8,"medianSec":15,"p75Sec":28}}
{"id":"mech-2.2-0060","topic":"Friction","learningObjective":"Explain the role of friction","practice":"clinician note","cognitiveDemand":{"bloom":"UNDERSTAND","dok":2},"format":"CONCEPT_MCQ","stimulus":null,"stem":"Friction converts kinetic energy to?","options":[{"id":"A","text":"Thermal energy","misconception":""},{"id":"B","text":"Potential energy","misconception":"confuses with conservative force"},{"id":"C","text":"Mass","misconception":"nonsense"},{"id":"D","text":"Nothing","misconception":"denies energy conversion"}],"answer":{"correctId":"A"},"explanation":"Friction dissipates kinetic energy as heat.","hint":"Friction produces heat.","difficulty":0.55,"discrimination":0.45,"responseTimeBaseline":{"p25Sec":10,"medianSec":18,"p75Sec":30}}
